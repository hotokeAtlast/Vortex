# Render Production Environment Variables
# Copy these to your Render dashboard environment variables
# DO NOT commit actual secrets to version control

# Server Configuration
PORT=
NODE_ENV=production

# Frontend URL (set to your actual frontend domain)
FRONTEND_URL=https://your-vortex-frontend.onrender.com

# Razorpay Production Keys (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_YOUR_PRODUCTION_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_PRODUCTION_SECRET_HERE
