# Backend (Express) Environment Variables
# Copy this file to server/.env for local development.
# In production, set these in the Render dashboard (Environment section).

# Server Configuration
PORT=10000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS, or `*` to allow all.
# In production set this to your deployed frontend URL (e.g. https://vortex.onrender.com).
FRONTEND_URL=http://localhost:5173

# Razorpay API Keys
# Get these from https://dashboard.razorpay.com/app/keys
# Use TEST keys (rzp_test_*) in development and LIVE keys (rzp_live_*) in production.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
