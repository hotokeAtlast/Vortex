PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Payment Gateway - Razorpay (https://razorpay.com)
# Get these from your Razorpay Dashboard
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Database (Optional - if using MongoDB instead of Firestore)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vortex

# JWT (Optional - if implementing JWT authentication)
# JWT_SECRET=your_jwt_secret_key_here

# Firebase (Optional - if moving backend to Firebase)
# FIREBASE_PROJECT_ID=your_firebase_project
# FIREBASE_PRIVATE_KEY=your_firebase_key
# FIREBASE_CLIENT_EMAIL=your_firebase_email

# Cloudinary (For image uploads)
# CLOUDINARY_NAME=your_cloudinary_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Admin Configuration
# ADMIN_EMAIL=hotoke.atlast@gmail.com
