# Frontend Environment Variables
# Copy this file to .env.local and fill in your Firebase credentials.
# When the frontend is served by the same Express server (Render single service),
# leave VITE_API_BASE_URL empty so calls go to relative `/api/...` paths.

# Firebase Configuration
# Get these from your Firebase Project Settings
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Razorpay Configuration
# This key is embedded in checkout - it's safe to expose (it's the public key)
VITE_RAZORPAY_KEY_ID=your_razorpay_public_key_here

# API Configuration
# Leave empty for same-origin production deploys (e.g. Render).
# Set to a full URL (e.g. http://localhost:5000) only when frontend and
# backend are hosted on different origins during local development.
VITE_API_BASE_URL=

